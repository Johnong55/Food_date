# Public app URL used for OAuth callbacks and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration. The anon key is safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Places server authentication. Use api_key for a stable server egress IP,
# or adc for OAuth/Application Default Credentials (recommended when IPs vary).
GOOGLE_PLACES_AUTH_MODE=api_key

# api_key mode: server-only. Restrict it to Places API (New) and, where the
# deployment permits, the server's egress IP addresses.
GOOGLE_MAPS_API_KEY=

# adc mode: server-only OAuth. Local development can use `gcloud auth
# application-default login`; GOOGLE_APPLICATION_CREDENTIALS is also supported.
GOOGLE_CLOUD_PROJECT_ID=

# Optional for adc mode on hosts without workload identity/ADC (for example,
# Vercel). Configure both values together and never prefix them with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional separate browser key, only when Maps JavaScript API is introduced.
# Restrict it by HTTPS referrer and to Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional application-owned infrastructure.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
