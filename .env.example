# Public app URL used for OAuth callbacks and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration. The anon key is safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only key for Places API (New). Restrict it to Places API (New) and,
# where the deployment permits, the server's egress IP addresses.
GOOGLE_MAPS_API_KEY=

# Optional separate browser key, only when Maps JavaScript API is introduced.
# Restrict it by HTTPS referrer and to Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional application-owned infrastructure.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
